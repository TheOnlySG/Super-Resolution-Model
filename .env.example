# --------(OPTIONAL)---------
# Environment Configuration for Satellite Imagery Super-Resolution Platform 

# Server Port (default: 8000)
PORT=8000

# Path to SR Model Weights (default: /app/model/RCAN_v2.pth inside container)
MODEL_PATH=/app/model/RCAN_v2.pth

# Execution Device: 'cpu' or 'cuda' (default: cpu inside standard container)
DEVICE=cpu
